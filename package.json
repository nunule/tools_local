{
  "name": "tools-local",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:mac": "CI=true tauri build --bundles app,dmg",
    "desktop:build:win": "tauri build --bundles nsis",
    "desktop:icons": "tauri icon public/icon.svg --output src-tauri/icons",
    "test": "vitest run && node --test scripts/desktop-downloads.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "predev": "npm run downloads:prepare",
    "prebuild": "npm run downloads:prepare",
    "downloads:prepare": "node scripts/prepare-desktop-downloads.mjs",
    "build:desktop": "tsc -b && vite build --mode desktop && node scripts/copy-desktop-assets.mjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@uiw/react-codemirror": "^4.23.8",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "wouter": "^3.5.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
